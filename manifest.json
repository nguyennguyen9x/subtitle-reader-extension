{
    "manifest_version": 3,
    "name": "YouTube Sherpa-ONNX Local Reader",
    "version": "2.0",
    "description": "Đọc phụ đề YouTube chuẩn xác 100% qua TimedText API với Sherpa-ONNX.",
    "permissions": [
        "storage"
    ],
    "host_permissions": [
        "http://127.0.0.1:5000/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Cài đặt Sherpa TTS"
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "injected.js"
            ],
            "matches": [
                "*://*.youtube.com/*"
            ]
        }
    ]
}